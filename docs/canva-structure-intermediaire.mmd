flowchart TB
    ROOT["mon-projet-handson-python - niveau intermediaire"]

    ROOT --> README["README.md"]
    ROOT --> REQ["requirements.txt - flask sqlalchemy pytest PyJWT"]
    ROOT --> ENV[".env - SECRET_KEY jamais commit"]
    ROOT --> DBFILE["digimarket.db - base SQLite cree au lancement"]

    subgraph APP["app - code API"]
        A_APP["app.py - Flask : crée l'app + enregistre les blueprints + run"]
        A_DB["db.py - engine SQLite + session partagée (évite l'import circulaire)"]
        A_SEC["security.py - F4 : creer/verifier token JWT, hachage, @login_required (401), @admin_required (403) - partie 4.11"]
        A_MODELS["modelsSQLAlchemy.py - objets : User (F1, 🥉) · Category+Product (F2, 🥈, FK 1-N partie 4.5) · Order+OrderItem (F3, au 🥇)"]
        A_AUTH["routes/auth.py - F1 : POST /api/auth/register (🥉) · POST /api/auth/login (🥈)"]
        A_PROD["routes/produits.py - F2 : GET /api/produits · GET /api/produits/<id> · POST/PUT/DELETE /api/produits[/<id>] (admin) · POST /api/categories (admin)"]
    end

    subgraph TESTS["tests - tests"]
        T_AUTH["test_auth.py - F1 : POST /api/auth/register → 409 doublon (🥉)"]
        T_CONF["conftest.py - fixtures 🥈 : base en mémoire + client_http + token_admin/token_client"]
        T_SEC["test_security.py - F1 login + F4 : token invalide/expiré → 401"]
        T_PROD["test_produits.py - F2 : CRUD produits/catégories → 201/400/401/403/409"]
    end

    subgraph DOCS["docs - documentation"]
        D_ET4["etape4-intermediaire.md"]
        D_ET5["etape5-tests-intermediaire.md"]
        D_ET6["etape6-backlog-intermediaire.md - fait, 8/8 cochées"]
        D_CANVA_B["canva-structure-debutant.mmd - niveau bronze fige"]
        D_CANVA_I["canva-structure-intermediaire.mmd - ce canva"]
    end

    ROOT --> APP
    ROOT --> TESTS
    ROOT --> DOCS

