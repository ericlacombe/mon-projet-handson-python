%% Rendu : copier ce bloc sur https://mermaid.live
%% Legende : fleche pleine = arborescence ; fleche pointillee + texte = import Python (le texte = le nom importe)
%% Sous-graphe docs/ supprimé pour la lisibilité : la liste des docs est dans README.md (section Structure du projet)
%% Niveau precedent conserve tel quel dans docs/canva-structure-debutant.mmd (jamais ecrase)
flowchart TB
    ROOT["mon-projet-handson-python - niveau intermediaire"]

    ROOT --> README["README.md"]
    ROOT --> REQ["requirements.txt - flask sqlalchemy pytest PyJWT"]
    ROOT --> ENV[".env - SECRET_KEY jamais commit"]
    ROOT --> GITIGN[".gitignore - .env, *.db, __pycache__/, venv/ jamais commités"]
    ROOT --> DBFILE["digimarket.db - base SQLite cree au lancement"]

    subgraph APP["app - code API"]
        A_APP["app.py - Flask : crée l'app + enregistre les blueprints + run"]
        A_DB["db.py - engine SQLite + session partagée (évite l'import circulaire)"]
        A_SEC["security.py - F4 : creer/verifier token JWT, hachage, @login_required (401), @admin_required (403) - partie 4.11"]
        A_MODELS["modelsSQLAlchemy.py - objets : User (F1, 🥉) · Category+Product (F2, 🥈, FK 1-N partie 4.5) · Order+OrderItem (F3, au 🥇)"]
        A_AUTH["routes/auth.py - F1 : POST /api/auth/register (🥉) · POST /api/auth/login (🥈)"]
        A_PROD["routes/produits.py - F2 : GET /api/produits · GET /api/produits/<id> · POST/PUT/DELETE /api/produits[/<id>] (admin) · POST /api/categories (admin)"]
    end


    subgraph CLIENT["client externe (hors code) : curl / Thunder Client / navigateur"]
        REQ1["POST /api/auth/register"]
        REQ2["POST /api/auth/login -> token"]
        REQ3["GET /api/produits?q=..."]
        REQ4["POST /api/produits (Bearer admin)"]
    end

    CLIENT -->|HTTP| A_APP
    ROOT --> APP

    A_APP -.->|auth_bp produits_bp| A_AUTH
    A_APP -.->|auth_bp produits_bp| A_PROD
    A_APP -.->|session| A_DB
    A_APP -.->|models| A_MODELS
    A_DB -.->|Base| A_MODELS
    A_DB -.->|"ecrit lit"| DBFILE
    A_AUTH -.->|session User| A_DB
    A_AUTH -.->|User creer_token verifier| A_MODELS
    A_AUTH -.->|security| A_SEC
    A_PROD -.->|session Product| A_DB
    A_PROD -.->|Product Category| A_MODELS
    A_PROD -.->|admin_required login_required| A_SEC
    A_SEC -.->|User check_password_hash| A_MODELS
    A_SEC -.->|"SECRET_KEY"| ENV

    FLOW["flux d'une requête : client → app.py → routes → security (vérif token 401/403) → db.py → models → digimarket.db"]
    A_APP -.-> FLOW

    style APP fill:#e8f4ff,stroke:#3b82f6
    style FLOW fill:#fef3c7,stroke:#d97706
